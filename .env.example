# Demo works without environment variables. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_MODE=demo
NEXT_PUBLIC_DEMO_MODE=true
# In live mode, the client appends /api/analyses to this origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Set to false to disable WebGL on every device.
NEXT_PUBLIC_ENABLE_3D=true
