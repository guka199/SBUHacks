# Copy to .env and fill in. Never commit .env.

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=POSTPILOT_SVC
# Key-pair auth (recommended): path to the private key; leave SNOWFLAKE_PASSWORD empty
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/snowflake_key.p8
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=POSTPILOT_WH
SNOWFLAKE_DATABASE=POSTPILOT
SNOWFLAKE_SCHEMA=APP
SNOWFLAKE_ROLE=POSTPILOT_APP
# This model must be enabled in your Snowflake region/account.
SNOWFLAKE_CORTEX_MODEL=llama3.3-70b
# Enrich a bounded batch per import; use POST /data/enrich to process remaining posts.
CORTEX_ENRICH_ON_INGEST=true
CORTEX_MAX_POSTS_PER_IMPORT=25

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=

# --- Public social account imports (backend only) ---
APIFY_API_TOKEN=
# Not part of the current product scope. Manual LinkedIn statistics remain supported.
PHANTOMBUSTER_ENABLED=false
PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_LINKEDIN_PROFILE_AGENT_ID=
PHANTOMBUSTER_LINKEDIN_POSTS_AGENT_ID=
# Optional LinkedIn Company Scraper; company activity is not included.
PHANTOMBUSTER_LINKEDIN_COMPANY_AGENT_ID=
# Configure the authorized LinkedIn connection in PhantomBuster, never here.
# Confirm these input keys against each saved agent's API setup.
PHANTOMBUSTER_LINKEDIN_PROFILE_INPUT_KEY=spreadsheetUrl
PHANTOMBUSTER_LINKEDIN_POSTS_INPUT_KEY=spreadsheetUrl
PHANTOMBUSTER_LINKEDIN_COMPANY_INPUT_KEY=spreadsheetUrl
# Optional supported count-argument names; blank uses the saved agent's limit.
PHANTOMBUSTER_LINKEDIN_PROFILE_LIMIT_KEY=numberOfAddsPerLaunch
PHANTOMBUSTER_LINKEDIN_POSTS_LIMIT_KEY=numberMaxOfPosts
PHANTOMBUSTER_LINKEDIN_COMPANY_LIMIT_KEY=
# Target adapter column -> actual exported column; confirm against your agent export.
PHANTOMBUSTER_LINKEDIN_PROFILE_FIELD_MAP={}
PHANTOMBUSTER_LINKEDIN_POSTS_FIELD_MAP={}
PHANTOMBUSTER_LINKEDIN_COMPANY_FIELD_MAP={}
# Official general guide uses Key-1; current endpoint reference also lists Key.
PHANTOMBUSTER_KEY_HEADER=X-Phantombuster-Key-1
# Optional comma-separated EXACT additional trusted HTTPS export hosts (no redirects).
# phantombuster.s3.amazonaws.com is built in. Do not use arbitrary user-provided hosts.
PHANTOMBUSTER_EXPORT_HOSTS=
# Enable only in ONE FastAPI process, with --workers 1. Disabled by default.
# No scraping occurs just by configuring credentials; user must import/refresh/enable schedule.
SOCIAL_WORKER_ENABLED=false

# --- Gemini (content review in POST /score) ---
GEMINI_API_KEY=
# Optional: model (default gemini-3.5-flash-lite, ~3 s), thinking level (e.g. low), blend (0.6 = 60% our model)
GEMINI_MODEL=
GEMINI_THINKING=
SCORE_MODEL_WEIGHT=0.6

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Backend ---
# Signs the login cookie. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Where the website finds the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Solana (devnet only) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
# Secret key of the wallet that pays out rewards, as a JSON array of numbers
REWARD_WALLET_SECRET_KEY=
# Mint address of the PostPilot reward token
REWARD_MINT_ADDRESS=
REWARD_TOKENS_PER_CONTRIBUTION=10
