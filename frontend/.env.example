# Live mode uses the local FastAPI backend; /demo remains an explicit sample.
# Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_DEMO_MODE=false
# Same-origin proxy keeps login cookies and video requests on the website's origin.
NEXT_PUBLIC_API_BASE_URL=/backend
# Server-only destination for /backend/* (not bundled into browser code).
API_URL=http://127.0.0.1:8000
# Set false for the capture path with live HTML; phones use it automatically.
# Reduced-motion preference also disables the pinned/automatic experience.
NEXT_PUBLIC_ENABLE_3D=true
