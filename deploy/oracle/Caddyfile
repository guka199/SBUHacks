# HTTPS certificate is issued automatically once api.viralpilot.us points to this VM.
api.viralpilot.us {
	request_body {
		max_size 210MB  # videos are up to 200 MB
	}
	reverse_proxy api:8000 {
		transport http {
			read_timeout 10m  # Gemini video reviews can take a few minutes
			write_timeout 10m
		}
	}
}
