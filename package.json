    "@react-three/fiber": "9.8.2",
    "framer-motion": "^12.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.180.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
