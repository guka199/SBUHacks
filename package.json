    "fetch:assets": "node scripts/fetch-licensed-assets.mjs",
    "build:keyboard": "node scripts/build-licensed-keyboard.mjs",
    "fetch:hardware": "node scripts/fetch-hardware-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
